@@ -309,6 +315,11 @@ export default function RecordScreen() {
   }, [isPromptAnswer, isReply]);
 
   const onPrimaryPressIn = useCallback(() => {
+    // Web: react-native-web fires onPress only from a DOM click, and a press whose target is swapped
+    // mid-press (stop square -> Continue disc) or a long touch hold gets none, so flags left by the
+    // last press ate this one (the first Continue tap did nothing). Each press starts clean.
+    swallowPressRef.current = false;
+    justArmedRef.current = false;
     if (isRecordingRef.current) {
