+  // Web demo: a just-published note goes live on the worker's next cron tick (up to a minute),
+  // after this screen has fetched, so poll the view and update only when the set of notes changed.
+  useEffect(() => {
+    if (Platform.OS !== "web") return undefined;
+    const id = setInterval(() => {
+      const seq = requestSeq.current;
+      fetchMapNotes(viewBounds)
+        .then((next) => {
+          if (seq !== requestSeq.current) return;
+          setNotes((prev) => {
+            const ids = new Set(prev.map((note) => note.id));
+            return prev.length === next.length && next.every((note) => ids.has(note.id)) ? prev : next;
+          });
+        })
+        .catch(() => {});
+    }, 15_000);
+    return () => clearInterval(id);
+  }, [viewBounds]);
