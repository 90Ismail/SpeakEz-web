        },
        {
          "type": "frame",
          "id": "PtnGN",
          "name": "Transcript",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 16,
          "padding": [
            24,
            "$gutter",
            120,
            "$gutter"
          ],
          "children": [
            {
              "type": "text",
              "id": "IMImL",
              "name": "Paragraph 1 (heard)",
              "fill": "$ink-2",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "I didn't really know where else to say this, so I'm saying it here — on the steps outside Walter, where I've basically lived for the last three weeks.",
              "lineHeight": 1.58,
              "fontFamily": "$serif",
              "fontSize": "$type-reading",
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "R57Ft",
              "name": "Paragraph 2 (playing)",
              "width": "fill_container",
              "layout": "vertical",
              "children": [
                {
                  "type": "text",
                  "id": "nLUeB",
                  "name": "Text",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Everyone keeps telling me I'm doing great. My advisor, my friends, my parents on the phone on Sundays. And I nod, and I say thanks, and then I come back here and sit with my laptop until the lights upstairs flicker off.",
                  "lineHeight": 1.58,
                  "fontFamily": "$serif",
                  "fontSize": "$type-reading",
                  "fontWeight": "normal"
                },
                {
                  "type": "rectangle",
                  "cornerRadius": 1,
                  "id": "d6b0NB",
                  "layoutPosition": "absolute",
                  "x": -16,
                  "y": 26,
                  "name": "Sync Bar",
                  "fill": "$accent",
                  "width": 2,
                  "height": 172
                }
              ]
            },
            {
              "type": "text",
              "id": "pSha9",
              "name": "Paragraph 3 (upcoming)",
              "fill": "$ink-3",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "It's not that anything terrible happened. It's more like everything is quietly asking for a little more than I have left.",
              "lineHeight": 1.58,
              "fontFamily": "$serif",
              "fontSize": "$type-reading",
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "QQfFR",
              "name": "Paragraph 4 (upcoming)",
              "fill": "$ink-3",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "I think I just wanted one person to know. Not to fix it. Just to know that someone was sitting here tonight, tired, and still trying.",
              "lineHeight": 1.58,
              "fontFamily": "$serif",
              "fontSize": "$type-reading",
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "o5sRN",
              "name": "Paragraph 5 (upcoming)",
              "fill": "$ink-3",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "If you're hearing this nearby — I hope your night is gentler than mine was.",
              "lineHeight": 1.58,
              "fontFamily": "$serif",
              "fontSize": "$type-reading",
              "fontWeight": "normal"
            }
          ]
        },
