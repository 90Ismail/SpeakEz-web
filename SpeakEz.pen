                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "D9bfaq",
              "name": "Transcript",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 16,
              "padding": [
                28,
                0,
                24,
                0
              ],
              "children": [
                {
                  "type": "text",
                  "id": "lEgMc",
                  "name": "Paragraph 1",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "I didn't really know where else to say this, so I'm saying it here — on the steps outside Walter, where I've basically lived for the last three weeks.",
                  "lineHeight": 1.58,
                  "fontFamily": "$serif",
                  "fontSize": "$type-reading",
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "XmlFx",
                  "name": "Paragraph 2",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Everyone keeps telling me I'm doing great. My advisor, my friends, my parents on the phone on Sundays. And I nod, and I say thanks, and then I come back here and sit with my laptop until the lights upstairs flicker off.",
                  "lineHeight": 1.58,
                  "fontFamily": "$serif",
                  "fontSize": "$type-reading",
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "a67HQh",
                  "name": "Paragraph 3",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "It's not that anything terrible happened. It's more like everything is quietly asking for a little more than I have left.",
                  "lineHeight": 1.58,
                  "fontFamily": "$serif",
                  "fontSize": "$type-reading",
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "hVX9V",
                  "name": "Paragraph 4",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "I think I just wanted one person to know. Not to fix it. Just to know that someone was sitting here tonight, tired, and still trying.",
                  "lineHeight": 1.58,
                  "fontFamily": "$serif",
                  "fontSize": "$type-reading",
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "pGfwJ",
                  "name": "Paragraph 5",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "If you're hearing this nearby — I hope your night is gentler than mine was.",
                  "lineHeight": 1.58,
                  "fontFamily": "$serif",
                  "fontSize": "$type-reading",
                  "fontWeight": "normal"
                }
              ]
            },
