                  "children": [
                    {
                      "type": "text",
                      "id": "b4cuBn",
                      "name": "Text",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Everyone keeps telling me I'm doing great. My advisor, [name removed], my friends, my parents on the phone on Sundays.",
                      "lineHeight": 1.58,
                      "fontFamily": "$serif",
                      "fontSize": "$type-reading",
                      "fontWeight": "normal"
