# Production-ish stack for docker-compose.prod.yml.
# Copy to .env and fill the two secrets. Everything here is host-agnostic:
# the same file works on a small VM, Railway, Fly.io or Render.

# --- Database (PostgreSQL 16 + PostGIS) ---
# Local compose default; on Railway/Fly/Render use the managed URL they give you
# (keep the postgresql+asyncpg:// scheme and add ?ssl=require when the provider asks).
POSTGRES_USER=speakez
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=speakez
DATABASE_URL=postgresql+asyncpg://speakez:change-me-strong@db:5432/speakez

# --- Cache / queue (Redis) ---
# Managed Redis providers hand out rediss:// (TLS) URLs; redis-py accepts both.
REDIS_URL=redis://redis:6379/0

# --- Secrets: generate with `openssl rand -hex 32` ---
# JWT_SECRET also signs media URLs, so a weak one lets anyone forge audio links.
JWT_SECRET=change-me
EMAIL_PEPPER=change-me-too

# --- App ---
# Public URL of the API, the address the GPU worker downloads audio from.
API_BASE_URL=http://localhost:8000
PORT=8000
ALLOWED_EMAIL_DOMAIN=umn.edu
UNLOCK_RADIUS_M=150
CORS_ORIGINS=*

# --- Optional TLS (docker-compose.prod.yml --profile tls) ---
# Caddy gets a free cert for this host and proxies to the api container.
# With sslip.io you need no domain: replace dots in the VPS IP with dashes,
# e.g. 203.0.113.7 -> api.203-0-113-7.sslip.io. Then set
# API_BASE_URL=https://api.203-0-113-7.sslip.io above.
API_HOST=api.localhost

# --- Storage / worker ---
STORAGE_BACKEND=local
MEDIA_DIR=/app/media
# 'demo' transcript (no GPU) or 'parakeet' (GPU worker). The cron runs either way.
ASR_ENGINE=demo
RESEND_API_KEY=

# Keep the demo honest: safety still runs, only the publish delay is skipped.
DEMO_MODE=true
