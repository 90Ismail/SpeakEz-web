DATABASE_URL=postgresql+asyncpg://speakez:speakez@db:5432/speakez
REDIS_URL=redis://redis:6379/0
STORAGE_BACKEND=local
MEDIA_DIR=/app/media
JWT_SECRET=change-me
EMAIL_PEPPER=change-me-too
ALLOWED_EMAIL_DOMAIN=umn.edu
RESEND_FROM=
RESEND_API_KEY=
UNLOCK_RADIUS_M=150
# Public URL of the API; the worker downloads audio from here when it has no media volume.
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=*
# Worker transcription engine: 'demo' (no GPU) or 'parakeet' (GPU worker).
ASR_ENGINE=demo
DEMO_MODE=true

# --- App (Expo reads these from the environment / .env at `npx expo start`) ---
# Public API the phone talks to, and the URL the in-app QR encodes for judges.
# EXPO_PUBLIC_API_URL=http://localhost:8000
# EXPO_PUBLIC_DEMO_URL=
